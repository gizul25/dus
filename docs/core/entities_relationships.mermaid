erDiagram
    User {
        string id
        string first_name
        string last_name
        string email
        string password_hash
        string role
        string status
        string? user_card_id
    }

    %% use proper connection type
    WebSocketConnection ||--o{ User : uses
    WebSocketConnection {
        string id
        string user_id
    }

    Desk ||--o{ DeskProfile : uses
    Desk {
        string id
        string name
        string rest_api_url
        int min_height_mm
        int max_height_mm
        int? manually_changed_desk_height_mm
        string? current_desk_profile_id
        string? pending_desk_profile_id
        bool is_desk_profile_autocorrection_enabled
    }

    DeskCategory ||--o{ DeskProfile : uses
    DeskCategory ||--o{ Desk : uses
    DeskCategory {
        string id
        string name
        string[] desk_ids
        string default_desk_profile_id
    }

    DeskSession ||--o{ User : uses
    DeskSession ||--o{ Desk : uses
    DeskSession ||--o{ Timer : uses
    DeskSession {
        string id
        string user_id
        string desk_id
        timestamp start_timestamp
        timestamp finished_timestamp
        string finished_reason
        string automatic_timeout_notification_timer_id
        string automatic_timeout_action_timer_id
    }

    DeskSessionConfig ||--o{ DeskSession : configures
    DeskSessionConfig {
        duration automatic_desk_association_timeout_duration
    }

    HealthReminder ||--o{ DeskProfile : uses
    HealthReminder ||--o{ DeskSession : uses
    HealthReminder ||--o{ Timer : uses
    HealthReminder {
        string id
        string desk_session_id
        timestamp start_timestamp
        duration time_elapsed_before_pause
        bool is_paused
        bool is_away_paused
        bool is_user_paused
        string next_reminder_timer_id
        string next_desk_profile_id
        string automatic_warning_timer_id
        bool is_automatic
    }

    HealthReminderPreferences ||--o{ DeskProfile : uses
    HealthReminderPreferences ||--o{ User : uses
    HealthReminderPreferences ||--o{ HealthReminder : configures
    HealthReminderPreferences {
        string id
        string user_id
        duration sitting_duration
        string main_sitting_desk_profile_id
        duration standing_duration
        string main_standing_desk_profile_id
        duration warning_duration
        bool is_automatic
        int middle_desk_height_threshold_mm
    }
    
    DeskProfile ||--o{ User : uses
    DeskProfile {
        string id
        string user_id
        string name
        int desk_height_mm
        int enter_desk_profile_threshold_mm
        int exit_desk_profile_threshold_mm
    }

    DeskIssue ||--o{ Desk : uses
    DeskIssue ||--o{ User : uses
    DeskIssue {
        string id
        string desk_id
        string? reporter_user_id
        timestamp created_timestamp
        timestamp resolved_timestamp
        string severity
        int? error_code
        string? title
        string? description
    }

    PicoEnvironmentalData ||--o{ Desk : uses
    PicoEnvironmentalData {
        string id
        string desk_id
        timestamp timestamp
        float temperature_celsius
        float humidity
        float light
    }

    LastDeskAPIFetch ||--o{ Desk : uses
    LastDeskAPIFetch ||--o{ RealtimeDeskAPIData : configures
    LastDeskAPIFetch ||--o{ PeriodicDeskAPIData : configures
    LastDeskAPIFetch ||--o{ Timer : uses
    LastDeskAPIFetch {
        string id
        string desk_id
        string next_realtime_desk_fetch_timer_id
        string next_periodic_desk_fetch_timer_id
        int desk_last_fetched_error_time_s
    }

    RealtimeDeskAPIData ||--o{ Desk : uses
    RealtimeDeskAPIData {
        string id
        string desk_id
        timestamp timestamp
        int desk_height_mm
        int speed_mms
    }

    PeriodicDeskAPIData ||--o{ Desk : uses
    PeriodicDeskAPIData {
        string id
        string desk_id
        string device_name
        string manufacturer
        string status
        bool is_position_lost
        bool is_overload_protection_up
        bool is_overload_protection_down
        bool is_anti_collision
    }

    FrontendTelemetry {
        string id
        string user_agent
        timestamp timestamp
        string error_message
        string? stack_trace
    }

    Timer {
        string id
        timestamp trigger_timestamp
    }
